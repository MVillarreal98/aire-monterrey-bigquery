# Datos crudos (JSONL de SINAICA, no se redistribuyen)
data/raw/*
data/download_log.txt
!data/raw/.gitkeep

# Datos procesados
data/processed/*
!data/processed/.gitkeep

# Outputs de análisis: los CSV agregados (outputs/0*.csv) y los mapas HTML
# (outputs/heatmap_*.html) SÍ se versionan como evidencia de los resultados.
# Cualquier otro archivo en outputs/ se ignora.
outputs/*
!outputs/0*.csv
!outputs/heatmap_*.html

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Credenciales — NUNCA a git
*.json.key
service-account*.json
.env
GOOGLE_APPLICATION_CREDENTIALS*
*.key

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Notebooks checkpoints
.ipynb_checkpoints/
